{
  "input": "preprocess/stage1/explaGraphs/samples.jsonl",
  "output_dir": "preprocess/stage2/explaGraphs",
  "limit": null,
  "encoder": "bert",
  "bert_model": "models/bert-base-uncased",
  "bert_encoder_mode": "contextual",
  "device": "cuda",
  "batch_size": 128,
  "max_length": 64,
  "pooling": "mean",
  "cache_dir": null,
  "local_files_only": false,
  "skip_cache_warmup": true,
  "clear_encoder_cache_each_sample": true,
  "stream": true,
  "method": "osrcd",
  "k_node": 10,
  "k_edge": 10,
  "hop": 3,
  "min_size": 3,
  "max_size": 25,
  "max_candidates": 64,
  "max_candidates_per_size": 4,
  "sigma": 0.5,
  "top_m": 8,
  "seed": 42,
  "num_samples": 2766,
  "evaluation_protocol": "graph_as_source_only; no node/edge PRF against the input graph; downstream LLM/human evaluation should judge retrieved evidence quality"
}